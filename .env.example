# Everything owner-specific comes from the environment. Unset values are hidden on the site: no
# placeholder links, no résumé button without a résumé, no form without a delivery channel.
# NEXT_PUBLIC_* values are inlined at build time — rebuild after changing them.

# Canonical origin for metadata, canonical URLs, sitemap.xml and robots.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" only on the production deployment. Every other build (local, preview, staging) answers
# robots.txt with "Disallow: /" and marks pages noindex.
NEXT_PUBLIC_SITE_INDEXABLE=

# The owner's real name: About page, footer, Person schema (JSON-LD) and the privacy notice.
NEXT_PUBLIC_OWNER_NAME=
# Age next to the name on the About page (a number: update it once a year).
NEXT_PUBLIC_OWNER_AGE=
# Portrait on the About page: a file in /public, e.g. /owner.jpg (portrait 4:5, at least 800x1000).
# Unset: the About page has no photo.
NEXT_PUBLIC_OWNER_PHOTO=

# Public contacts. Profiles must be https URLs.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# A booking page (Calendly, Cal.com…), shown as "Book a call" when set.
NEXT_PUBLIC_SCHEDULING_URL=

# The résumé: a file in /public (e.g. /cv.pdf) or an https URL. Without it no download is offered.
NEXT_PUBLIC_RESUME_URL=

# The live Orders API (backend/): enables the playground's "Live API" mode. Locally, after
# `docker compose up -d --build` in backend/: http://localhost:8000. Unset: simulation only.
NEXT_PUBLIC_LIVE_API_URL=

# Plausible Analytics (cookieless). The domain registered in Plausible; unset: no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only for a self-hosted Plausible (e.g. in the EU); defaults to Plausible Cloud.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Contact form → Telegram (server only, never NEXT_PUBLIC_). Read at build time: the contact page is
# static, so without both values the form is not rendered and only email and profiles are shown.
# Token from @BotFather; chat id is the numeric id of the chat that receives messages (or @channel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
