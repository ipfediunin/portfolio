# Copy to .env (never commit it). docker compose reads it automatically.

# PostgreSQL and RabbitMQ passwords of the local stack.
POSTGRES_PASSWORD=runtime-dev
RABBITMQ_PASSWORD=runtime-dev

# Keys the daily-rotating hash of client IPs (rate limiting). Use a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORDERS_API_IP_HASH_SECRET=local-dev-ip-hash-secret

# The Orders API calls the Payments API's /internal/ endpoints with this token (16+ characters).
INTERNAL_TOKEN=local-dev-internal-token

# Django's SECRET_KEY for the Payments API and its admin (sessions, CSRF). Long and random in
# production.
BACKOFFICE_SECRET_KEY=local-dev-backoffice-secret-key-change-me

# Website origins allowed to call the APIs from the browser.
ORDERS_API_CORS_ORIGINS=["http://localhost:3000"]
BACKOFFICE_CORS_ORIGINS=http://localhost:3000

# Production (compose.prod.yaml) has its own template: .env.production.example, turned into .env
# on the server by scripts/init-prod-env.sh with random secrets. See docs/stage-7/vps-deploy.md.

# For running services on the host (uv run …) against the compose stack:
ORDERS_API_DATABASE_URL=postgresql+asyncpg://runtime:runtime-dev@127.0.0.1:5433/runtime_city
ORDERS_API_REDIS_URL=redis://127.0.0.1:6380/0
ORDERS_API_AMQP_URL=amqp://runtime:runtime-dev@127.0.0.1:5673/runtime_city
# The outbox relay (uv run orders-api-relay) publishes to Kafka's host listener.
ORDERS_API_KAFKA_BOOTSTRAP=127.0.0.1:9094
ORDERS_API_PAYMENTS_URL=http://127.0.0.1:8001
ORDERS_API_INTERNAL_TOKEN=local-dev-internal-token
ORDER_WORKER_DATABASE_URL=postgresql+asyncpg://runtime:runtime-dev@127.0.0.1:5433/runtime_city
ORDER_WORKER_REDIS_URL=redis://127.0.0.1:6380/0
ORDER_WORKER_AMQP_URL=amqp://runtime:runtime-dev@127.0.0.1:5673/runtime_city
ORDER_WORKER_KAFKA_BOOTSTRAP=127.0.0.1:9094
# The provider stub has no host port; run it with `uv run provider-stub` (port 8100) for this.
ORDER_WORKER_PROVIDER_URL=http://127.0.0.1:8100
# The owner's Telegram bot (ops-bot). A bot of its own from @BotFather, not the contact form's.
# Owner ids: your Telegram user id (ask @userinfobot). Locally the bot polls Telegram; on the
# server set the webhook transport, the site's https address and a random secret of 32+ chars.
OPS_BOT_TELEGRAM_TOKEN=
OPS_BOT_OWNER_IDS=[]
OPS_BOT_TRANSPORT=polling
OPS_BOT_PUBLIC_URL=
OPS_BOT_WEBHOOK_SECRET=
REALTIME_HUB_REDIS_URL=redis://127.0.0.1:6380/0
REALTIME_HUB_ALLOWED_ORIGINS=["http://localhost:3000"]
BACKOFFICE_DATABASE_URL=postgresql://runtime:runtime-dev@127.0.0.1:5433/runtime_city
BACKOFFICE_REDIS_URL=redis://127.0.0.1:6380/0
BACKOFFICE_PROVIDER_URL=http://127.0.0.1:8100
BACKOFFICE_INTERNAL_TOKEN=local-dev-internal-token
