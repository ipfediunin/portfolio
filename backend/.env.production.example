# Production settings of the single VPS: the website and the live backend (compose.prod.yaml).
# On the server: `sh backend/scripts/init-prod-env.sh` creates backend/.env from this file with a
# fresh random value for every secret. The public data below is already filled in; only the bot
# token is added on the server (never commit it, nor .env). Runbook: docs/stage-7/vps-deploy.md.

# --- Domains and certificates ------------------------------------------------------------------
# The website's domain, without https:// and www: the site is https://SITE_DOMAIN, and
# www.SITE_DOMAIN redirects there. The live API is on a subdomain, e.g. api.SITE_DOMAIN.
# DNS: A records (and AAAA with IPv6) for SITE_DOMAIN, www.SITE_DOMAIN and API_DOMAIN → the server.
SITE_DOMAIN=fediunin.com
API_DOMAIN=api.fediunin.com
# Let's Encrypt writes here about expiring certificates.
ACME_EMAIL=fediuninmichail@gmail.com

# --- Secrets (generated by scripts/init-prod-env.sh) -------------------------------------------
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
INTERNAL_TOKEN=
ORDERS_API_IP_HASH_SECRET=
BACKOFFICE_SECRET_KEY=
OPS_BOT_WEBHOOK_SECRET=

# --- The website: the owner's public data --------------------------------------------------------
# Inlined into the site at build time: after a change, rebuild (`up -d --build`). Empty: not shown.
NEXT_PUBLIC_OWNER_NAME=Mikhail Fediunin
# A number, updated once a year.
NEXT_PUBLIC_OWNER_AGE=31
# A file in the repository's public/ folder, e.g. /owner.jpg (portrait 4:5, at least 800x1000).
NEXT_PUBLIC_OWNER_PHOTO=/photo/photomain.png
NEXT_PUBLIC_CONTACT_EMAIL=fediuninmichail@gmail.com
# Profiles: full https URLs.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/michail-fediunin-49b9a1442
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/marglpo
# A booking page (Calendly, Cal.com…).
NEXT_PUBLIC_SCHEDULING_URL=
# The résumé: a file in public/ (e.g. /cv.pdf) or an https URL.
NEXT_PUBLIC_RESUME_URL=
# Plausible Analytics (cookieless); empty: no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# --- Contact form → Telegram (@fediunin_bot) -------------------------------------------------------
# Both empty: the contact page shows only the email and profiles. Chat id: the owner's numeric
# Telegram user id (not secret); the owner has to /start the bot once, or it cannot message them.
# The token is secret: add it on the server only.
CONTACT_TELEGRAM_BOT_TOKEN=
CONTACT_TELEGRAM_CHAT_ID=

# --- Ops bot (optional) ---------------------------------------------------------------------------
# Writes to the owner about real problems and answers /status, /dlq, /alerts. Without a token it
# only logs the alerts. It can be the same bot as the contact form (the form only sends messages;
# the ops bot takes Telegram's webhook). Owner ids: a JSON list with the owner's user id.
OPS_BOT_TELEGRAM_TOKEN=
OPS_BOT_OWNER_IDS=[]
